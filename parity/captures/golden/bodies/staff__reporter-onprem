      <label class="reason"><input type="radio" name="reason" value="data" required> Its data source is broken or unavailable</label>
      
      <label class="reason"><input type="radio" name="reason" value="reconfiguring" required> Being reconfigured: skills, permissions or engine</label>
      
      <label class="reason"><input type="radio" name="reason" value="duplicate" required> Another analyst covers the same ground</label>
      
      <label class="reason"><input type="radio" name="reason" value="other"> Something else, written below</label>
