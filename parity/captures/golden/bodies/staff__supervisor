<dialog id="statedlg" class="dlg">
  <form method="post" action="/staff/supervisor/state"><input type="hidden" name="csrf" value="<CSRF>">
    <h2 style="margin-top:0">Suspend supervisor</h2>
    <p class="fine">Their record, history and
    stamps stay exactly as they are. Only the ability to run work under their
    name goes away, and you can undo it here at any time.
    The reason is written into the journal, so this decision can be explained
    six months from now.</p>
    <input type="hidden" name="state" value="suspended">
    <div class="reasons">
      
      <label class="reason"><input type="radio" name="reason" value="cost" required> Costing too much for what it returns</label>
      
      <label class="reason"><input type="radio" name="reason" value="budget" required> Monthly guard reached or exceeded</label>
      
      <label class="reason"><input type="radio" name="reason" value="quality" required> Deliverables keep coming back on review</label>
      
      <label class="reason"><input type="radio" name="reason" value="not-needed" required> Desk is quiet, no work for it now</label>
      
      <label class="reason"><input type="radio" name="reason" value="data" required> Its data source is broken or unavailable</label>
      
      <label class="reason"><input type="radio" name="reason" value="reconfiguring" required> Being reconfigured: skills, permissions or engine</label>
      
      <label class="reason"><input type="radio" name="reason" value="duplicate" required> Another analyst covers the same ground</label>
      
      <label class="reason"><input type="radio" name="reason" value="other"> Something else, written below</label>
    </div>
    <textarea name="reason_other" rows="2" placeholder="If none of the above fits, write the reason here"></textarea>
    <div class="dlgacts">
      <button type="button" class="btn back" onclick="document.getElementById('statedlg').close()">Cancel</button>
      <button class="btn">Suspend</button>
    </div>
  </form>
</dialog>

