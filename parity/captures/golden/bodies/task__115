<script>
document.addEventListener('input', function (e) {
  var box = e.target.closest('.filterbox'); if (!box) return;
  var root = document.querySelector(box.dataset.target); if (!root) return;
  var q = box.value.trim().toLowerCase();
  root.querySelectorAll('[data-search]').forEach(function (el) {
    var hit = !q || el.dataset.search.toLowerCase().indexOf(q) !== -1;
    if (el.classList.contains('deskgroup')) {
      var inner = Array.prototype.some.call(el.querySelectorAll('[data-search]'),
        function (x) { return x.dataset.search.toLowerCase().indexOf(q) !== -1; });
      el.style.display = (hit || inner || !q) ? '' : 'none';
      el.querySelectorAll('[data-search]').forEach(function (x) {
        x.style.display = (!q || hit || x.dataset.search.toLowerCase().indexOf(q) !== -1) ? '' : 'none';
      });
    } else if (!el.closest('.deskgroup')) {
      el.style.display = hit ? '' : 'none';
    }
  });
});
document.addEventListener('click', function (e) {
  if (e.target.classList && e.target.classList.contains('grip')) return;
  var th = e.target.closest('th'); if (!th) return;
  var table = th.closest('table'); if (!table) return;
  var idx = Array.prototype.indexOf.call(th.parentNode.children, th);
  var rows = Array.prototype.slice.call(table.querySelectorAll('tr')).filter(
    function (r) { return r.querySelector('td'); });
  var dir = th.dataset.dir === 'asc' ? -1 : 1;
  table.querySelectorAll('th').forEach(function (h) { delete h.dataset.dir;
    var a = h.querySelector('.arrow'); if (a) a.remove(); });
  th.dataset.dir = dir === 1 ? 'asc' : 'desc';
  var arrow = document.createElement('span');
  arrow.className = 'arrow';
  arrow.textContent = dir === 1 ? ' \u25B2' : ' \u25BC';
  th.appendChild(arrow);
  function key(r) {
    var c = r.children[idx]; if (!c) return '';
    var txt = c.textContent.trim().replace(/[$,%]/g, '').replace(/,/g, '');
    if (/\d{4}-\d{2}-\d{2}/.test(txt)) return txt.replace(/[^\d-]/g, '');
    var n = parseFloat(txt);
    return isNaN(n) ? txt.toLowerCase() : n;
  }
  rows.sort(function (a, b) {
    var ka = key(a), kb = key(b);
    if (typeof ka === 'number' && typeof kb === 'number') return (ka - kb) * dir;
    return String(ka).localeCompare(String(kb)) * dir;
  });
  rows.forEach(function (r) { r.parentNode.appendChild(r); });
});

/* ---- tables you can widen, and that fit any screen -----------------------
   Every table is put in its own horizontally scrolling box, so a wide table
   scrolls inside its panel instead of pushing the whole page sideways. Each
   header cell gets a grip on its right edge: drag it to widen the column,
   double-click it to give the column back to the browser. Widths are
   remembered per page, because a column you widened once you almost always
   want wide again.                                                          */
(function () {
  var KEY = 'costcrew.colw.' + location.pathname;
  var saved = {};
  try { saved = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (err) { saved = {}; }

  function persist() {
    try { localStorage.setItem(KEY, JSON.stringify(saved)); } catch (err) { /* private mode */ }
  }

  function setup() {
    document.querySelectorAll('table').forEach(function (table, ti) {
      if (!table.parentNode.classList.contains('tw')) {
        var box = document.createElement('div');
        box.className = 'tw';
        table.parentNode.insertBefore(box, table);
        box.appendChild(table);
      }
      /* An atom never breaks: a date, a sum, a status, a short name. Prose
         does break, and must, or one sentence drags the whole table wider
         than the screen and everything else scrolls to reach it. The rule is
         length, applied once, because CSS cannot ask how long a text is. */
      table.querySelectorAll('td, th').forEach(function (cell) {
        if (cell.children.length) return;
        var txt = (cell.textContent || '').trim();
        if (txt.length > 40 && txt.indexOf(' ') !== -1) cell.classList.add('wrap');
      });

      /* Really long prose gets two lines and a way to open the rest. Nothing
         is removed: the full text is still in the cell, still searched by
         the filter box, still there for anyone who presses. */
      table.querySelectorAll('td').forEach(function (cell) {
        if (cell.querySelector('.clamp')) return;
        var txt = (cell.textContent || '').trim();
        if (txt.length <= 110) return;
        var box = document.createElement('div');
        box.className = 'clamp';
        while (cell.firstChild) box.appendChild(cell.firstChild);
        cell.appendChild(box);
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'more';
        btn.textContent = 'more';
        btn.setAttribute('aria-expanded', 'false');
        btn.addEventListener('click', function (ev) {
          ev.stopPropagation();
          var open = box.classList.toggle('open');
          btn.textContent = open ? 'less' : 'more';
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });
        cell.appendChild(btn);
        cell.classList.add('wrap');
      });
      /* Align each header to the column beneath it. The figures are right
         aligned and the headers were not, so every numeric column read as a
         label on the left with unrelated numbers on the right. */
      var head0 = table.querySelector('tr');
      if (head0) {
        var body = Array.prototype.slice.call(table.querySelectorAll('tr'))
          .filter(function (r) { return r.querySelector('td'); });
        head0.querySelectorAll('th').forEach(function (th, ci) {
          var nums = 0, cells = 0;
          body.forEach(function (r) {
            var cell = r.children[ci];
            if (!cell || cell.tagName !== 'TD') return;
            cells++;
            if (cell.classList.contains('num')) nums++;
          });
          if (cells && nums * 2 > cells) th.classList.add('num');
        });
      }
      var head = table.querySelector('tr');
      if (!head) return;
      head.querySelectorAll('th').forEach(function (th, ci) {
        var id = ti + ':' + ci;
        if (saved[id]) { th.style.width = saved[id] + 'px'; th.classList.add('sized'); }
        if (th.querySelector('.grip')) return;
        var grip = document.createElement('span');
        grip.className = 'grip';
        grip.title = 'Drag to widen, double-click to reset';
        grip.addEventListener('dblclick', function (ev) {
          ev.stopPropagation();
          th.style.width = ''; th.classList.remove('sized');
          delete saved[id]; persist();
        });
        grip.addEventListener('pointerdown', function (ev) {
          ev.preventDefault(); ev.stopPropagation();
          var x0 = ev.clientX, w0 = th.getBoundingClientRect().width;
          grip.classList.add('on');
          grip.setPointerCapture(ev.pointerId);
          function move(e2) {
            var w = Math.max(48, Math.round(w0 + (e2.clientX - x0)));
            th.style.width = w + 'px'; th.classList.add('sized');
            saved[id] = w;
          }
          function up() {
            grip.classList.remove('on');
            grip.removeEventListener('pointermove', move);
            grip.removeEventListener('pointerup', up);
            persist();
          }
          grip.addEventListener('pointermove', move);
          grip.addEventListener('pointerup', up);
        });
        th.appendChild(grip);
      });
    });
    document.querySelectorAll('.tw').forEach(function (box) {
      function mark() {
        /* a few pixels is rounding, not a hidden column */
        var over = box.scrollWidth > box.clientWidth + 8;
        box.classList.toggle('scrolls', over);
        box.classList.toggle('atend',
          over && box.scrollLeft + box.clientWidth >= box.scrollWidth - 2);
      }
      box.addEventListener('scroll', mark);
      window.addEventListener('resize', mark);
      mark();
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup);
  } else { setup(); }
})();
</script>
